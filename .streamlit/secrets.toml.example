# Local dev: copy this file to ".streamlit/secrets.toml" and fill in real values.
# That real file is gitignored. On Streamlit Community Cloud, paste the same
# key = value lines into:  Manage app -> Settings -> Secrets  (append, don't replace).

# Shared access password for the app's login gate (read via st.secrets).
# Leave unset/blank to disable the gate (the board stays open).
app_password = "change-me"

# Live odds sources (read as env vars by Settings). Optional locally; without
# them the board falls back to clearly-labelled DEMO odds.
ODDS_API_KEY = "your-odds-api-key"
BALLDONTLIE_API_KEY = "your-balldontlie-key"
