# --- Kalshi -----------------------------------------------------------------
# Market-data reads are PUBLIC and need none of these. Credentials are only
# required for trading/portfolio endpoints (Slice 2+). Generate a key in your
# Kalshi account settings; the private key is shown once — save it as a .pem.
KALSHI_ENV=prod                       # prod | demo  (demo = sandbox for paper plumbing)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=              # e.g. ~/.kalshi/private_key.pem

# --- Sports data (Slice 1+) -------------------------------------------------
# Free tiers are fine to start. Live auto-trading will likely need paid tiers
# for fresh odds/injuries — that's a later cost decision, not a v1 blocker.
ODDS_API_KEY=                         # the-odds-api.com
BALLDONTLIE_API_KEY=                  # balldontlie.io
DATA_TIER=free                        # free | paid
